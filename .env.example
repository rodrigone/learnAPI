# Copie para .env

# Banco. Local: SQLite. Produção: troque para a connection string do Postgres
# (e o provider em prisma/schema.prisma para "postgresql"). Veja DEPLOY.md.
DATABASE_URL="file:./dev.db"

# Segredo para assinar a sessão (JWT). Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# E-mails autorizados a entrar (separados por vírgula).
ALLOWED_EMAILS="rodrigon.edington@gmail.com"

# Login com Google (Google Cloud Console → OAuth 2.0 Client ID).
# Em desenvolvimento, se ficarem vazios, o login entra direto (modo dev).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# URL pública da app em produção (ex.: https://investly.vercel.app).
# Usada para montar o redirect_uri exato exigido pelo Google. Em dev pode ficar
# vazia (usa a origem da requisição).
AUTH_URL=""
